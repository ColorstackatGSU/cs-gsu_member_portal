# Copy to .env.local. Only VITE_-prefixed vars reach the browser.
#
# The anon key is safe in the bundle: it can start a sign in and nothing else, because
# self-signup is disabled and every table it could reach has RLS. The service_role key must
# never appear here.

# Run `supabase start` in ../cs-gsu_backend, which owns the Supabase project.
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# `./mvnw spring-boot:run` in ../cs-gsu_backend.
VITE_API_BASE_URL=http://127.0.0.1:8080

# In production, set all three in Vercel:
#   VITE_SUPABASE_URL=https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<anon key>
#   VITE_API_BASE_URL=https://api.colorstackatgsu.com
